{
  "name": "usp",
  "version": "0.1.0",
  "description": "Ultimate Social Poster CLI for publishing Markdown posts to X, LinkedIn, Reddit, Telegram, Aegea, Bluesky, Mastodon, and Discord.",
  "type": "module",
  "bin": {
    "usp": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "action.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-prompts.mjs",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "prepack": "npm run build"
  },
  "keywords": [
    "social",
    "cli",
    "markdown",
    "x",
    "linkedin",
    "reddit",
    "telegram",
    "bluesky",
    "mastodon",
    "discord"
  ],
  "author": "Adam Arutyunov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamarutyunov/usp.git"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@clack/core": "^1.3.0",
    "@clack/prompts": "^1.3.0",
    "@google/genai": "^1.52.0",
    "commander": "^14.0.3",
    "date-fns": "^4.4.0",
    "mime": "^4.1.0",
    "ora": "^9.4.0",
    "playwright": "^1.59.1",
    "twitter-api-v2": "^1.29.0",
    "yaml": "^2.8.4",
    "yoctocolors": "^2.1.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
